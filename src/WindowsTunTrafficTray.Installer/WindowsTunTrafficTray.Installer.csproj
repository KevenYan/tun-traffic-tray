<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\assets\TunTraffic.ico</ApplicationIcon>
    <AssemblyName>WindowsTunTrafficTraySetup</AssemblyName>
    <RootNamespace>WindowsTunTrafficTray.Installer</RootNamespace>
    <Version>0.1.2</Version>
    <AssemblyVersion>0.1.2.0</AssemblyVersion>
    <FileVersion>0.1.2.0</FileVersion>
  </PropertyGroup>

  <ItemGroup Condition="Exists('Resources\payload.zip')">
    <EmbeddedResource Include="Resources\payload.zip" LogicalName="Payload.zip" />
  </ItemGroup>
</Project>
