<Window x:Class="WindowsTunTrafficTray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="520" Height="260" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Controller URL" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding ControllerUrl, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="1" Text="Secret" VerticalAlignment="Center" Margin="0,12,0,0" />
        <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="SecretBox" Margin="0,12,0,0" />

        <TextBlock Grid.Row="2" Text="Poll seconds" VerticalAlignment="Center" Margin="0,12,0,0" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0" />

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,14,0,0" Foreground="#666"
                   Text="Settings are saved under your Windows user profile. Do not commit the settings file to GitHub."
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="88" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Save" Width="88" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
