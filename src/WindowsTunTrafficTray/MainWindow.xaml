<Window x:Class="WindowsTunTrafficTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:WindowsTunTrafficTray"
        Title="TUN &#x6d41;&#x91cf;&#x76d1;&#x63a7;" Width="1280" Height="760" MinWidth="980" MinHeight="620"
        Background="#EEF1F5">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="12,4" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="#D9EAFF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="BluePillButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
            <Setter Property="Background" Value="#1683F8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type local:UsageNode}" ItemsSource="{Binding Children}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="390" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Chain}" TextTrimming="CharacterEllipsis" Foreground="#64748B" />
                <TextBlock Grid.Column="2" Text="{Binding DownloadText}" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{Binding UploadText}" TextAlignment="Right" />
                <TextBlock Grid.Column="4" Text="{Binding DownloadRateText}" TextAlignment="Right" />
                <TextBlock Grid.Column="5" Text="{Binding UploadRateText}" TextAlignment="Right" />
                <TextBlock Grid.Column="6" Text="{Binding Path}" TextTrimming="CharacterEllipsis" Foreground="#64748B" />
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="18,28,18,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="ChartDonut" Width="34" Height="34" Foreground="#111827" Margin="0,0,10,0" />
                        <TextBlock Text="TUN Traffic" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource PrimaryNavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Home" Width="24" Height="24" Margin="0,0,20,0" />
                            <TextBlock Text="&#x9996;&#x9875;" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="Records_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CalendarText" Width="24" Height="24" Margin="0,0,20,0" />
                            <TextBlock Text="&#x6bcf;&#x65e5;&#x8bb0;&#x5f55;" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Cog" Width="24" Height="24" Margin="0,0,20,0" />
                            <TextBlock Text="&#x8bbe;&#x7f6e;" FontSize="18" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border DockPanel.Dock="Top" Margin="14,22,14,0" Padding="12" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="32" Height="32" CornerRadius="7" Background="#E8F3FF" Margin="0,0,8,0">
                                <iconPacks:PackIconMaterial Kind="ServerNetwork" Width="20" Height="20" Foreground="#1683F8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="&#x6d41;&#x91cf;&#x89c6;&#x56fe;" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                        <UniformGrid Columns="1">
                            <Button Style="{StaticResource PillButtonStyle}" Content="&#x5168;&#x90e8;" Margin="0,0,0,8" Click="FilterAll_Click"
                                    Background="{Binding AllFilterBackground}" Foreground="{Binding AllFilterForeground}" />
                            <Button Style="{StaticResource PillButtonStyle}" Content="&#x4ee3;&#x7406;" Margin="0,0,0,8" Click="FilterProxy_Click"
                                    Background="{Binding ProxyFilterBackground}" Foreground="{Binding ProxyFilterForeground}" />
                            <Button Style="{StaticResource PillButtonStyle}" Content="&#x76f4;&#x8fde;" Margin="0" Click="FilterDirect_Click"
                                    Background="{Binding DirectFilterBackground}" Foreground="{Binding DirectFilterForeground}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Margin="22,0,22,18" Padding="0,12,0,0" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Canvas Width="170" Height="58" Margin="0,0,0,8">
                            <Line X1="0" X2="170" Y1="8" Y2="8" Stroke="#E5E7EB" StrokeThickness="1" />
                            <Line X1="0" X2="170" Y1="29" Y2="29" Stroke="#E5E7EB" StrokeThickness="1" />
                            <Line X1="0" X2="170" Y1="50" Y2="50" Stroke="#E5E7EB" StrokeThickness="1" />
                            <Polyline Points="{Binding UploadSeriesPoints}" Stroke="#FFB195" StrokeThickness="2.5" StrokeLineJoin="Round" />
                            <Polyline Points="{Binding DownloadSeriesPoints}" Stroke="#1683F8" StrokeThickness="2.5" StrokeLineJoin="Round" />
                        </Canvas>
                        <Grid Margin="4,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="ArrowUp" Width="16" Height="16" Foreground="#FF8A65" />
                            <TextBlock Grid.Column="1" Text="{Binding SessionUploadRateValue}" FontSize="18" Foreground="#FF8A65" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding SessionUploadRateUnit}" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Bottom" />
                        </Grid>
                        <Grid Margin="4,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="ArrowDown" Width="16" Height="16" Foreground="#1683F8" />
                            <TextBlock Grid.Column="1" Text="{Binding SessionDownloadRateValue}" FontSize="18" Foreground="#1683F8" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding SessionDownloadRateUnit}" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Bottom" />
                        </Grid>
                        <Grid Margin="4,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="Cog" Width="16" Height="16" Foreground="#111827" />
                            <TextBlock Grid.Column="1" Text="{Binding SessionTotalValue}" FontSize="18" Foreground="#111827" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding SessionTotalUnit}" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Height="74" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedViewTitle}" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource MetricCardStyle}" Background="#F2F8FF" BorderBrush="#BBD9FF" Padding="14,10" Margin="6,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#DCEEFF" Margin="0,0,10,0">
                                    <iconPacks:PackIconMaterial Kind="ArrowDown" Width="18" Height="18" Foreground="#1683F8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="&#x4e0b;&#x8f7d;&#x91cf;" Foreground="#8C8C8C" FontSize="12" />
                                    <TextBlock Text="{Binding SelectedDownloadText}" FontSize="17" FontWeight="Bold" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCardStyle}" Background="#FFF8F5" BorderBrush="#FFD8CC" Padding="14,10" Margin="6,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#FFE8DE" Margin="0,0,10,0">
                                    <iconPacks:PackIconMaterial Kind="ArrowUp" Width="18" Height="18" Foreground="#FF8A65" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="&#x4e0a;&#x4f20;&#x91cf;" Foreground="#8C8C8C" FontSize="12" />
                                    <TextBlock Text="{Binding SelectedUploadText}" FontSize="17" FontWeight="Bold" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCardStyle}" Background="#F0FBF5" BorderBrush="#C3EFD5" Padding="14,10" Margin="6,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#DCF8E8" Margin="0,0,10,0">
                                    <iconPacks:PackIconMaterial Kind="LinkVariant" Width="18" Height="18" Foreground="#13A060" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="&#x6d3b;&#x8dc3;&#x8fde;&#x63a5;" Foreground="#8C8C8C" FontSize="12" />
                                    <TextBlock Text="{Binding ActiveConnectionsText}" FontSize="17" FontWeight="Bold" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="16,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="8" Background="#E8F3FF">
                                    <iconPacks:PackIconMaterial Kind="Table" Width="24" Height="24" Foreground="#1683F8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="&#x8fde;&#x63a5;&#x8be6;&#x60c5;" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>

                            <Border DockPanel.Dock="Top" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial Kind="Magnify" Width="22" Height="22" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="15"
                                             Padding="10,7"
                                             ToolTip="&#x8f93;&#x5165;&#x8fdb;&#x7a0b;&#x540d;&#x6216;&#x8def;&#x5f84;&#x8fdb;&#x884c;&#x641c;&#x7d22;" />
                                </Grid>
                            </Border>

                            <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="14">
                                <DataGrid x:Name="ConnectionsGrid"
                                          ItemsSource="{Binding ConnectionRows}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeColumns="True"
                                          CanUserSortColumns="True"
                                          IsReadOnly="True"
                                          FontSize="14"
                                          RowHeight="36"
                                          ColumnHeaderHeight="38"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          SelectionMode="Single"
                                          PreviewMouseRightButtonDown="ConnectionsGrid_PreviewMouseRightButtonDown">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="&#x6253;&#x5f00;&#x8fdb;&#x7a0b;&#x4f4d;&#x7f6e;" Click="OpenProcessLocation_Click" />
                                            <MenuItem Header="&#x5173;&#x95ed;&#x8fdb;&#x7a0b;" Click="CloseProcess_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="&#x8fdb;&#x7a0b;" SortMemberPath="Name" Width="260" MinWidth="180" CanUserResize="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}"
                                                               Margin="{Binding IndentMargin}"
                                                               FontWeight="{Binding RowFontWeight}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="&#x4e0b;&#x8f7d;&#x91cf;" Binding="{Binding DownloadText}" SortMemberPath="Download" Width="120" MinWidth="100" />
                                        <DataGridTextColumn Header="&#x4e0a;&#x4f20;&#x91cf;" Binding="{Binding UploadText}" SortMemberPath="Upload" Width="120" MinWidth="100" />
                                        <DataGridTextColumn Header="&#x4e0b;&#x8f7d;&#x901f;&#x5ea6;" Binding="{Binding DownloadRateText}" SortMemberPath="DownloadRate" Width="125" MinWidth="110" />
                                        <DataGridTextColumn Header="&#x4e0a;&#x4f20;&#x901f;&#x5ea6;" Binding="{Binding UploadRateText}" SortMemberPath="UploadRate" Width="125" MinWidth="110" />
                                        <DataGridTextColumn Header="&#x8def;&#x5f84;" Binding="{Binding Path}" SortMemberPath="Path" Width="360" MinWidth="220" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </DockPanel>
                    </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
